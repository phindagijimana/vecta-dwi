{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vecta.example.org/schemas/v0.1/output/research_outcome.schema.json",
  "title": "Vecta-DWI ResearchOutcome",
  "description": "Independent downstream outcome joined to a Vecta assessment. NOT emitted by the deterministic engine — populated by the outcome-labeling procedure (docs/paper1_outcome_labeling_manual.md). Kept in a separate schema per Output Tech Spec §35.",

  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "session_id",
    "outcome_id",
    "definition_version",
    "value",
    "state",
    "labeling_method",
    "computed_at"
  ],
  "properties": {
    "subject_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "outcome_id": { "$ref": "../_defs.schema.json#/$defs/OutcomeID" },
    "definition_version": { "$ref": "../_defs.schema.json#/$defs/SemVer" },
    "value": {
      "description": "Value type depends on outcome_id (bool for success flags, string for enum outcomes, number for continuous). May be null when state != observed."
    },
    "state": {
      "type": "string",
      "enum": ["observed", "unknown", "not_applicable"]
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "labeling_method": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": ["string", "null"] },
    "reviewer_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "adjudication_status": {
      "type": "string",
      "enum": ["not_required", "pending", "confirmed", "rejected", "modified"]
    },
    "computed_at": { "$ref": "../_defs.schema.json#/$defs/ISO8601DateTime" }
  }
}
