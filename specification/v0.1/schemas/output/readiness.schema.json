{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vecta.example.org/schemas/v0.1/output/readiness.schema.json",
  "title": "Vecta-DWI ReadinessSummary",
  "description": "Profile-relative summary. Never replaces the underlying criteria/findings. Source: Output Tech Spec §19-21.",

  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "profile_version", "state", "dimensions", "rule_version"],
  "properties": {
    "profile_id": { "$ref": "../_defs.schema.json#/$defs/ProfileID" },
    "profile_version": { "$ref": "../_defs.schema.json#/$defs/SemVer" },
    "state": { "$ref": "../_defs.schema.json#/$defs/readiness_state" },

    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_integrity": { "$ref": "#/$defs/DimensionState" },
        "metadata_sufficiency": { "$ref": "#/$defs/DimensionState" },
        "representation_integrity": { "$ref": "#/$defs/DimensionState" },
        "protocol_conformance": { "$ref": "#/$defs/DimensionState" },
        "processing_readiness": { "$ref": "#/$defs/DimensionState" },
        "assessment_completeness": { "$ref": "#/$defs/AssessmentCompleteness" }
      }
    },

    "blocking_finding_refs": {
      "type": "array",
      "items": { "$ref": "../_defs.schema.json#/$defs/FindingID" }
    },
    "review_finding_refs": {
      "type": "array",
      "items": { "$ref": "../_defs.schema.json#/$defs/FindingID" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rule_version": { "type": "string", "minLength": 1 }
  },

  "allOf": [
    {
      "description": "state=ready is incompatible with any blocking finding.",
      "if": { "properties": { "state": { "const": "ready" } } },
      "then": {
        "properties": {
          "blocking_finding_refs": { "maxItems": 0 }
        }
      }
    }
  ],

  "$defs": {
    "DimensionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "../_defs.schema.json#/$defs/readiness_state" },
        "contributing_findings": {
          "type": "array",
          "items": { "$ref": "../_defs.schema.json#/$defs/FindingID" }
        }
      }
    },
    "AssessmentCompleteness": {
      "type": "object",
      "description": "Source: Output Tech Spec §21.",
      "additionalProperties": false,
      "required": ["applicable_variables", "observed_or_derived", "ratio", "calculation_id"],
      "properties": {
        "applicable_variables": { "type": "integer", "minimum": 0 },
        "observed_or_derived": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "not_collected": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 },
        "extraction_failed": { "type": "integer", "minimum": 0 },
        "evaluable_criteria": { "type": "integer", "minimum": 0 },
        "unknown_criteria": { "type": "integer", "minimum": 0 },
        "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculation_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
